{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EveryDesk",
  "version": "0.1.0",
  "identifier": "br.com.everydesk.app",
  "mainBinaryName": "EveryDesk",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "EveryDesk",
        "width": 1100,
        "height": 720,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rafael Fachini",
    "copyright": "© 2026 Rafael Fachini. Baseado no RustDesk (AGPL-3.0).",
    "category": "Utility",
    "shortDescription": "Acesso remoto ao seu computador",
    "longDescription": "EveryDesk é um aplicativo de acesso remoto: permite controlar outro computador ou deixar que alguém de confiança acesse o seu, com conexão criptografada.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../../LICENCE",
    "resources": {
      "../../LICENCE": "LICENCE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "COLE_AQUI_A_CHAVE_PUBLICA_DO_UPDATER",
      "endpoints": [
        "https://github.com/rafaelfachini029-ship-it/everydesk/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
